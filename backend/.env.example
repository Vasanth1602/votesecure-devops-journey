PORT=5000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=voting_db
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (AES-256 - must be exactly 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=your_32_char_encryption_key_here!

# Frontend URL (CORS)
# Local Docker: http://localhost:5173
# Phase 4 Cloud: update to your actual domain e.g. https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Default admin seed credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@votesecure.com
ADMIN_PASSWORD=your_strong_admin_password_here

# SMTP (optional - for vote confirmation emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
